{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Store POS",
  "version": "0.9.0",
  "identifier": "com.mohammad.storeapp",

  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },

  "app": {
    "windows": [
      {
        "title": "Store POS",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },

  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": { "language": ["en-US", "ar-SA"] }
    },
    "linux": {
      "deb": {
        "desktopTemplate": "./packaging/store-pos.desktop"
      }
    }
  },

  "plugins": {
    "sql": {
      "preload": ["sqlite:store.db"]
    }
  }
}
